# Copia este archivo a .env y rellénalo. Nunca subas .env al repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Mínimo 32 caracteres. Si falta, se genera uno al arrancar y las sesiones se pierden al reiniciar.
JWT_SECRET=
# Producción (PostgreSQL). Sin DB_URL se usa una base H2 en ./data
DB_URL=
DB_USER=
DB_PASSWORD=
CORS_ORIGIN=http://localhost:5173
